---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>POPKØRN</title>
  </head>
  <body>
    <canvas id="webgl"></canvas>
    <script>
      import { GridDistortion } from '../grid-distortion/GridDistortion';

      const canvas = document.getElementById('webgl');
      if (canvas instanceof HTMLCanvasElement) {
        new GridDistortion(canvas, '/popkorn.png').start();
      }
    </script>
  </body>
</html>
